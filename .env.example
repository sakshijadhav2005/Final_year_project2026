# App
EVENTAI_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Postgres
DATABASE_URL=postgresql+asyncpg://eventai:eventai@localhost:5432/eventai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# VideoDB (server-side only — never VITE_*)
VIDEODB_API_KEY=
VIDEODB_COLLECTION=

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL_GENERATE=gemini-3.6-flash
GEMINI_MODEL_ANALYZE=gemini-3.6-flash

# RAG
RAG_TOKEN_THRESHOLD=12000
RAG_ENABLED=true

# Media & Storage Settings
MAX_UPLOAD_MB=500
MAX_UPLOAD_SIZE_MB=500
UPLOAD_CHUNK_SIZE=5242880
MAX_DURATION_SEC=10800
MEDIA_RETENTION_HOURS=72
CLAMAV_ENABLED=false
MEDIA_ROOT=./data/media
LOCAL_STORAGE_PATH=./data/media
MEDIA_STORAGE_PREFIX=media

# Cloud Storage Backend: 'local' (default), 'r2' (Cloudflare R2), 's3' (AWS S3), or 'minio'
STORAGE_BACKEND=local
STORAGE_FALLBACK_TO_LOCAL=true

# Cloudflare R2 (https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eventai-recordings
R2_PUBLIC_DOMAIN=

# Generic S3 (AWS S3 or MinIO)
# Leave S3_ENDPOINT_URL empty for standard AWS S3; specify for MinIO or custom S3
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=eventai-recordings
S3_BUCKET_NAME=eventai-recordings
S3_REGION=auto


# Sentry (optional)
SENTRY_DSN=
