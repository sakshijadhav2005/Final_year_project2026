# App
EVENTAI_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-long-random-string
# Login tokens are renewed automatically in the background, so a short value is safe
ACCESS_TOKEN_EXPIRE_MINUTES=240
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Postgres
DATABASE_URL=postgresql+asyncpg://eventai:eventai@localhost:5432/eventai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# VideoDB (server-side only — never VITE_*)
VIDEODB_API_KEY=
VIDEODB_COLLECTION=

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL_GENERATE=gemini-3.6-flash
GEMINI_MODEL_ANALYZE=gemini-3.6-flash

# AI provider for all text steps (analysis, drafts, guardrails, translation, chat):
#   gemini    - Google Gemini direct
#   vertex    - Gemini on Google Cloud Vertex AI (uses gcloud login, no API key)
#   anthropic - Claude via your Anthropic API key (alias: claude)
#   portkey   - Portkey -> OpenAI -> Groq -> Gemini gateway
LLM_PROVIDER=gemini

# Vertex AI - used when LLM_PROVIDER=vertex
# Setup: gcloud auth application-default login
#        gcloud services enable aiplatform.googleapis.com --project <id>
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Empty = reuse GEMINI_MODEL_GENERATE / GEMINI_MODEL_FAST
VERTEX_MODEL=
VERTEX_FAST_MODEL=

# Claude (Anthropic API) - used when LLM_PROVIDER=anthropic
# Get a key at https://platform.claude.com (starts with sk-ant-)
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (best quality/price), claude-haiku-5-5 (fastest, cheapest), claude-opus-5-5 (strongest)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Used automatically if ANTHROPIC_MODEL is unavailable on your account
ANTHROPIC_FALLBACK_MODEL=claude-haiku-5-5
# How long Claude thinks before answering: low (fastest), medium, high
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=8000

PORTKEY_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Speed
# Speech-to-text engine: auto (Gemini if GEMINI_API_KEY is set - fastest), gemini, or videodb
# Claude cannot transcribe audio, so keep GEMINI_API_KEY or VIDEODB_API_KEY for recordings
STT_PROVIDER=auto
# Print every SQL query to the console (slow, only for database debugging)
SQL_ECHO=false
# Max seconds for one Gemini / Claude request before it is retried / falls back
LLM_TIMEOUT_SECONDS=60
# A model that fails this many calls in a row is skipped for the window, then tried again
MODEL_CIRCUIT_FAIL_MAX=3
MODEL_CIRCUIT_RESET_SECONDS=60
# Check API keys / Google credentials at start-up and skip engines whose key is rejected
VALIDATE_CREDENTIALS_ON_STARTUP=true
# Let blog/LinkedIn/newsletter agents call web search. false = fastest (one call per draft)
AGENT_TOOLS_ENABLED=false
# A tool-using agent falls back to a plain call after this many seconds
AGENT_TIMEOUT_SECONDS=45
# Max seconds for one web search
TOOL_TIMEOUT_SECONDS=8

# RAG
# Words. Writers see the first ~2,000 words; longer transcripts use retrieval.
RAG_TOKEN_THRESHOLD=2000
RAG_ENABLED=true
RAG_TOP_K=6
# similarity (evaluated default) | balanced (spread retrieval over the talk, ask writers to cover all of it)
RAG_STRATEGY=similarity
# Vertex AI embeddings (needs GOOGLE_CLOUD_PROJECT); falls back to hashed bag-of-words
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Regional endpoint for embeddings (global is much slower); nearest region to the server
RAG_EMBEDDING_LOCATION=us-central1

# Media
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=10800
MEDIA_RETENTION_HOURS=72
CLAMAV_ENABLED=false
MEDIA_ROOT=./data/media

# Cloud Storage: 'local' (default) or 'r2' (Cloudflare R2) or 's3' (AWS/MinIO)
STORAGE_BACKEND=local

# Cloudflare R2 (https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eventai-recordings
R2_PUBLIC_DOMAIN=

# Generic S3 (optional fallback for AWS S3 or MinIO)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=eventai-recordings

# Error-repair agent (only when EVENTAI_ENV=development).
# Errors caught while the app runs are fixed by Claude Code in a separate git worktree
# (outside the repo), tested, risk-scanned, and listed in Admin -> Error fixes.
# Nothing is committed or pushed until you click "Approve & push".
# Opt-in: the backend runs tests on code the agent wrote before you have reviewed it,
# so enable it only on a machine whose API port is not reachable by others.
AUTOFIX_ENABLED=false
# Empty = find `claude` on PATH, then the Claude Code VS Code extension
AUTOFIX_AGENT_CMD=
# Empty = the CLI's default model
AUTOFIX_MODEL=
AUTOFIX_MAX_PER_DAY=10
# Spending cap per agent call (USD)
AUTOFIX_MAX_BUDGET_USD=2.0
# Agent edits -> tests -> feedback, at most this many rounds per fix
AUTOFIX_MAX_ROUNDS=3
# A second agent call that reviews each diff for correctness and security
AUTOFIX_LLM_REVIEW=true
AUTOFIX_REMOTE=origin
# Every model call of the agent goes through the Portkey gateway: one trace per error
# (x-portkey-trace-id = autofix-<id>), metadata per stage, cost and logs in Portkey.
# Needs PORTKEY_API_KEY (above) plus ONE way for Portkey to reach Claude:
#   AUTOFIX_PORTKEY_CONFIG       config id (recommended: retries, fallbacks, caching), or
#   AUTOFIX_PORTKEY_VIRTUAL_KEY  virtual key holding your Anthropic key, or
#   ANTHROPIC_API_KEY            forwarded by Portkey to Anthropic
# Without these the agent waits and the Error fixes page says what is missing.
# "direct" skips the gateway and uses the Claude Code login instead.
AUTOFIX_LLM_GATEWAY=portkey
AUTOFIX_PORTKEY_BASE_URL=https://api.portkey.ai
AUTOFIX_PORTKEY_CONFIG=
AUTOFIX_PORTKEY_VIRTUAL_KEY=

# Sentry (optional)
SENTRY_DSN=

# Social publishing: post approved drafts to the user's own LinkedIn.
# 1. Create an app at https://developer.linkedin.com (needs a LinkedIn company page).
# 2. Products tab: add "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect".
# 3. Auth tab: add the redirect URL below exactly, then copy the client id and secret.
# Users connect their account in Settings -> Connected accounts.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/linkedin/callback
# Web app address; the browser returns here (/settings) after connecting.
FRONTEND_URL=http://localhost:5173

# Instagram publishing (Business or Creator accounts; no Facebook Page needed).
# 1. developers.facebook.com -> Create app -> add the "Instagram" product
#    ("API setup with Instagram login").
# 2. Copy the *Instagram* app id and secret (not the Facebook app id).
# 3. "Set up Instagram business login": add the redirect URL below exactly.
# 4. In development mode, add your Instagram account as an Instagram tester (App roles).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/social/instagram/callback
# Instagram downloads the post image itself, so it needs a public https URL:
# - STORAGE_BACKEND=r2 (or s3) works as is (bucket / presigned URL), or
# - set PUBLIC_BASE_URL to this API's public address, e.g. from `ngrok http 8000`.
PUBLIC_BASE_URL=

# Facebook Pages: posts approved LinkedIn or Instagram drafts to your first Page.
# 1. developers.facebook.com -> Create app ("Business") -> add "Facebook Login for Business".
# 2. Valid OAuth Redirect URIs: add the URL below exactly.
# 3. Permissions: pages_show_list, pages_manage_posts, pages_read_engagement
#    (work for app admins/testers in development mode; others need App Review).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/social/facebook/callback

# X (Twitter): posts approved X drafts (the "X Post" content type, 280 characters).
# 1. developer.x.com -> Project & App -> User authentication settings:
#    OAuth 2.0, type "Web App" (confidential client), permissions "Read and write".
# 2. Callback URI: the URL below exactly. Copy the OAuth 2.0 Client ID and Client Secret.
# 3. Posting needs an X API plan with write access.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/social/x/callback

# Scheduled posts are checked this often (seconds) by the API process.
# With USE_CELERY=true, Celery beat sends them every minute instead.
SOCIAL_SCHEDULER_INTERVAL_SECONDS=30
